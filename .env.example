# ============================================================================
# Timesheet Intelligence Portal — UNIVERSAL environment template
#
# THIS is the only env file shipped in git. Private copies (.env, .env.local,
# .env.dev, .env.prod) stay on your machine and are gitignored.
#
# Setup:
#   ./scripts/create-env.sh          # interactive: pick LOCAL / DEV / PROD → writes .env
#   ./scripts/create-env.sh LOCAL    # or pass a profile directly
#   ./scripts/create-env.sh DEV --force   # overwrite existing .env
# Then start:
#   ./scripts/local/start.sh | ./scripts/dev/start.sh | ./scripts/prod/start.sh
#
# Profiles (same keys; values differ) are the commented blocks below.
#
# Profiles (same keys everywhere; only values differ):
#   LOCAL  → docker-compose.local.yml   (Postgres + local disk in Docker)
#   DEV    → docker-compose.dev.yml     (AWS RDS + S3)
#   PROD   → docker-compose.prod.yml    (production; replace CHANGE_ME)
#
# Backend alone (no Docker): copy to backend/.env and use localhost hosts.
# ============================================================================

# ---- environment ----
ENVIRONMENT=dev                 # dev | prod | local

# ---- database (PostgreSQL only) ----
# Docker local/prod: host "db". AWS RDS: put the RDS endpoint in DATABASE_URL.
DATABASE_URL=postgresql+asyncpg://timesheet:timesheet@localhost:5432/timesheet
POSTGRES_USER=timesheet
POSTGRES_PASSWORD=timesheet
POSTGRES_DB=timesheet
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
# true = create missing tables on startup (quick local). Docker/RDS: false + Alembic.
AUTO_CREATE_TABLES=true

# ---- infrastructure ----
REDIS_URL=redis://localhost:6379/0
CACHE_ENABLED=true
CACHE_TTL_SECONDS=300
CELERY_TASK_ALWAYS_EAGER=true   # true = run tasks inline (no worker needed)

# ---- concurrency (docker-compose.*.yml) ----
UVICORN_WORKERS=2
CELERY_CONCURRENCY=2

# Scheduled jobs (Celery beat), hours between pipeline-raw purges
PIPELINE_RAW_PURGE_INTERVAL_HOURS=24
# Celery beat gate for the monthly reminder check (28th/9am UAE). This is a
# SEPARATE switch from the DB toggle on the Reminders page — here's why both
# exist instead of just one:
#   - The DB toggle is a runtime value an admin flips from the UI, no restart
#     needed. That's convenient, but it also means it can end up ON by
#     accident on a box it should never be on for — e.g. this local machine
#     got a copy of the production database (real employee emails) and that
#     copy happened to have the toggle already switched on.
#   - This env var is the blunt backstop for that case: false means Celery
#     beat never even registers the reminder job at process startup — it
#     is not "scheduled but skipping", it does not run, at all — so no DB
#     value, however it got set, can ever cause a send on this box.
# true  = normal / prod: the job runs hourly and ALSO still needs the DB
#         toggle on AND it to actually be the 28th/9am UAE before anything
#         sends — this var alone does not turn sending on.
# false = any box holding real employee data that must never send from here
#         (e.g. local dev) — full stop, the DB toggle becomes irrelevant.
REMINDER_SCHEDULED_CHECK_ENABLED=true
# A second, harder kill-switch — the var above only stops the HOURLY
# SCHEDULED check from running at all; it does nothing for the Reminders
# page's own "Send now" / "Run for all now" / "Test email" buttons, which
# send for real regardless of it. This one is checked inside the mailer
# itself (reminders/mailer.py), so as long as it's false NOTHING sent through
# the reminders flow — scheduled or manual — can ever actually reach a real
# inbox. Set false on any box holding real employee data.
REMINDER_SENDING_ENABLED=true
# Same idea, completely separate flow: a hard kill-switch for actually
# emailing an OTP login code (checked in auth/email_otp.py). Independent of
# REMINDER_SENDING_ENABLED above — flipping one never touches the other.
# Login still works when false only if DEBUG_OTP_ENABLED (below) is also on.
OTP_SENDING_ENABLED=true
# Whether /auth/login hands the OTP code straight back in the API response
# instead of requiring the real emailed one — a testing/demo shortcut, not an
# environment-name thing. Leave false on every real box (local/dev/prod
# alike) so logging in always exercises the real "check your inbox" path;
# the test suite turns this on for itself (see backend/tests/conftest.py),
# which is the one legitimate reason to ever set it true.
DEBUG_OTP_ENABLED=false

# System health monitoring — a THIRD, fully separate email feature from
# reminders/OTP above (own mailer, own DB table, own flags — flipping any of
# the reminder/OTP settings has zero effect on this and vice versa). Checks
# the LLM API key/credits + Microsoft Graph credential every N hours and
# emails SYSTEM_HEALTH_ALERT_EMAIL (falls back to DEFAULT_ADMIN_EMAIL if
# blank) the moment either breaks, and again once it recovers — so an
# expired key/secret stops failing silently, one call at a time, with
# nothing surfacing why.
SYSTEM_HEALTH_CHECK_ENABLED=true
SYSTEM_HEALTH_CHECK_INTERVAL_HOURS=6
# Once alerted, don't re-alert the SAME still-broken component again until
# this many hours pass — avoids spamming every check tick while still
# nudging periodically so it's never forgotten.
SYSTEM_HEALTH_ALERT_RESEND_HOURS=24
SYSTEM_HEALTH_ALERT_EMAIL=
# The LLM check only ever reports exact facts, never a guess: key valid or
# not, and for OpenRouter, credits exhausted or not (its own API returns the
# real remaining balance — no "running low" heuristic, since there's no way
# to know how many $ a given prompt will cost ahead of time).
#
# The Graph check is the live client-credentials token exchange (same as
# OTP/reminders use) — proves the credential works RIGHT NOW, but Graph's
# token endpoint can't reveal when the secret will EXPIRE. For an advance
# warning, set GRAPH_CLIENT_SECRET_EXPIRES_ON near GRAPH_OTP_SENDER below
# (copied from Azure Portal) — this is how many days ahead of that date to
# start warning.
SYSTEM_HEALTH_GRAPH_EXPIRY_WARN_DAYS=30

# ---- auth / security ----
AUTH_ENABLED=true
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-bytes
ACCESS_TOKEN_TTL_MINUTES=480
LOGIN_TOKEN_TTL_MINUTES=10

DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin
DEFAULT_ADMIN_EMAIL=admin@example.com

# OTP lifecycle
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_LIMIT=3
OTP_RESEND_COOLDOWN_SECONDS=30

# rate limiting (sliding window)
LOGIN_RATE_MAX=10
LOGIN_RATE_WINDOW_SECONDS=300
OTP_VERIFY_RATE_MAX=20
OTP_VERIFY_RATE_WINDOW_SECONDS=300

# CAPTCHA issuance throttle
CAPTCHA_RATE_MAX=20
CAPTCHA_RATE_WINDOW_SECONDS=30

# CAPTCHA answer-verification throttle
CAPTCHA_VERIFY_RATE_MAX=20
CAPTCHA_VERIFY_RATE_WINDOW_SECONDS=300

# Authenticator (TOTP) verify throttle
TOTP_VERIFY_RATE_MAX=20
TOTP_VERIFY_RATE_WINDOW_SECONDS=300
TOTP_ISSUER=Timesheets

# captcha + fingerprint
CAPTCHA_LENGTH=6
CAPTCHA_TTL_SECONDS=180
FINGERPRINT_REQUIRED=true

# Pipeline retry copies — max age (days) for still-failed originals
PIPELINE_RAW_RETENTION_DAYS=120
# Where failed-file originals are kept for Retry.
#   STORAGE_PROVIDER=local → set a disk path (e.g. /app/storage/_pipeline-raw)
#   STORAGE_PROVIDER=s3    → leave EMPTY (copies live under S3_RAW_PREFIX on S3)
# Empty + local also falls back to backend default data/pipeline_raw.
PIPELINE_RAW_ROOT=

# ---- providers ----
EMAIL_PROVIDER=mock             # mock | graph
STORAGE_PROVIDER=local          # local | s3  (onedrive is a stub — do not use)
EXTRACTION_ENGINE=mock          # mock | vision

# ---- AI / extraction (.env only — Admin → Settings is read-only) ----
EXTRACTION_ENGINE=mock          # mock | vision
# "openai" gets the native Files/Responses API (PDF/DOCX/XLSX uploaded
# directly). Any other value (e.g. "openrouter") is treated as a plain
# chat-completions gateway — files are rendered to images client-side first,
# since third-party gateways don't expose OpenAI's own file storage. Set this
# to match whatever OPENAI_BASE_URL actually points at.
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com
OPENAI_VISION_MODEL=gpt-4o
EXTRACTION_MODEL=gpt-4o

# ---- two-pass extraction (see services/extract_email/{triage,thread}_prompt.py) ----
PASS1_IMAGE_DETAIL=low          # pass 1 (classify: timesheet? whose? signed?) — low resolution is enough
VISION_IMAGE_DETAIL=low         # pass 2 (extract: read every day-by-day cell) — high | low; high reads finer print but costs more per image
PASS1_BATCH_SIZE=5              # items per pass-1 call on a long thread
MAX_IMAGES_PER_CALL=12          # images per pass-2 call
PDF_MAX_PAGES=12
IMG_MAX_DIM=1600                # px, longest side, for images sent to the model
MIN_IMAGE_BYTES=61440           # 60 KB — smaller = logo/icon, dropped before either pass
# Separate from MIN_IMAGE_BYTES above (different code path, different unit):
# this one hides tiny image attachments from the INBOX listing/counts and
# attachment-type classifier (never shown as a real screenshot), whereas
# MIN_IMAGE_BYTES drops them from what's actually SENT to the vision model.
MIN_IMAGE_ATTACHMENT_KB=70
OCR_MIN_CHARS=20                # standalone picture attachments under this OCR char count are noise
ATTACHMENT_MODE=image           # image | native
USE_LIBREOFFICE=true            # render xlsx/docx to page images via headless LibreOffice

# ---- cost / accuracy tuning ----
PDF_RENDER_DPI=150
VISION_JSON_MODE=true
OCR_PROVIDER=none               # none | tesseract

# Inbox sync throttle: at most one incremental Graph sync per N seconds; in
# between, the inbox list + search serve instantly from the local DB.
INBOX_SYNC_MIN_INTERVAL_SECONDS=60
# Background inbox sync (Celery beat) — pulls new mail on this schedule
# regardless of whether anyone has the Inbox page open, so it's already in
# the DB by the time someone looks. Shares the same throttle/lock as the
# on-demand sync above, so this never duplicates a request-triggered pull.
# false = never register the beat job at all (same on/off-at-startup pattern
# as REMINDER_SCHEDULED_CHECK_ENABLED above).
INBOX_AUTO_SYNC_ENABLED=true
INBOX_AUTO_SYNC_INTERVAL_SECONDS=60

# ---- AI data security ----
PII_REDACTION=true

# ---- agentic chat ----
AGENT_CHAT_MODEL=gpt-4o-mini

# ---- file storage (STORAGE_PROVIDER=s3) ----
S3_BUCKET=
S3_PREFIX=timesheets
S3_RAW_PREFIX=_pipeline-raw
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# S3_ENDPOINT_URL=

# ---- Microsoft Graph (EMAIL_PROVIDER=graph) ----
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
# Secret *Value* from Azure, NOT the Secret ID (UUID).
GRAPH_CLIENT_SECRET=
GRAPH_MAILBOX=timesheets@yourcompany.com
GRAPH_FOLDER=Inbox
GRAPH_OTP_SENDER=timesheets@yourcompany.com
# Copied from Azure Portal -> App registrations -> Certificates & secrets,
# "YYYY-MM-DD" — the system health check (above) warns
# SYSTEM_HEALTH_GRAPH_EXPIRY_WARN_DAYS before this. Blank = no advance
# warning (the live already-broken check still applies regardless).
GRAPH_CLIENT_SECRET_EXPIRES_ON=

# ---- CORS ----
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]


