# =============================================================================
# PROFILE: PROD  —  docker-compose.prod.yml
# AWS RDS + S3 (same architecture as DEV — see docs/AWS_SETUP.md /
# docs/DEPLOYMENT.md). No local db service in this compose file — RDS is the
# only database. Replace every CHANGE_ME. Prefer strong JWT / DB / admin passwords.
# =============================================================================
# ENVIRONMENT=prod
# DATABASE_URL=postgresql+asyncpg://ts_app:CHANGE_ME@your-db.xxxxxxxx.region.rds.amazonaws.com:5432/timesheet?ssl=require
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# AUTO_CREATE_TABLES=false
# REDIS_URL=redis://redis:6379/0
# CACHE_ENABLED=true
# CACHE_TTL_SECONDS=300
# CELERY_TASK_ALWAYS_EAGER=false
# UVICORN_WORKERS=4               # 4-vCPU box (e.g. m6i.xlarge) — 2 if still on t3.large
# CELERY_CONCURRENCY=4            # match vCPU count — also bump docker-compose.prod.yml's own
                                   # resource limits when you raise this (see its header comment)
# PIPELINE_RAW_PURGE_INTERVAL_HOURS=24
# REMINDER_SCHEDULED_CHECK_ENABLED=true
# REMINDER_SENDING_ENABLED=true
# OTP_SENDING_ENABLED=true
# DEBUG_OTP_ENABLED=false
# SYSTEM_HEALTH_CHECK_ENABLED=true
# SYSTEM_HEALTH_CHECK_INTERVAL_HOURS=6
# SYSTEM_HEALTH_ALERT_RESEND_HOURS=24
# SYSTEM_HEALTH_ALERT_EMAIL=
# SYSTEM_HEALTH_GRAPH_EXPIRY_WARN_DAYS=30
# AUTH_ENABLED=true
# JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
# ACCESS_TOKEN_TTL_MINUTES=480
# LOGIN_TOKEN_TTL_MINUTES=10
# DEFAULT_ADMIN_USERNAME=admin
# DEFAULT_ADMIN_PASSWORD=CHANGE_ME
# DEFAULT_ADMIN_EMAIL=admin@yourcompany.com
# OTP_LENGTH=6
# OTP_TTL_SECONDS=300
# OTP_MAX_ATTEMPTS=5
# OTP_RESEND_LIMIT=3
# OTP_RESEND_COOLDOWN_SECONDS=30
# LOGIN_RATE_MAX=10
# LOGIN_RATE_WINDOW_SECONDS=300
# OTP_VERIFY_RATE_MAX=20
# OTP_VERIFY_RATE_WINDOW_SECONDS=300
# CAPTCHA_RATE_MAX=20
# CAPTCHA_RATE_WINDOW_SECONDS=30
# CAPTCHA_VERIFY_RATE_MAX=20
# CAPTCHA_VERIFY_RATE_WINDOW_SECONDS=300
# TOTP_VERIFY_RATE_MAX=20
# TOTP_VERIFY_RATE_WINDOW_SECONDS=300
# TOTP_ISSUER=Timesheets
# CAPTCHA_LENGTH=6
# CAPTCHA_TTL_SECONDS=180
# FINGERPRINT_REQUIRED=true
# PIPELINE_RAW_RETENTION_DAYS=120
# PIPELINE_RAW_ROOT=              # empty: PROD uses S3 raw prefix, not local disk
# EMAIL_PROVIDER=graph
# STORAGE_PROVIDER=s3
# EXTRACTION_ENGINE=vision
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com
# EXTRACTION_MODEL=gpt-4o
# VISION_IMAGE_DETAIL=low
# OPENAI_VISION_MODEL=gpt-4o
# PDF_RENDER_DPI=150
# VISION_JSON_MODE=true
# OCR_PROVIDER=none
# PII_REDACTION=true
# AGENT_CHAT_MODEL=gpt-4o-mini
# S3_BUCKET=your-prod-bucket
# S3_PREFIX=timesheets
# S3_RAW_PREFIX=_pipeline-raw
# S3_REGION=us-east-1
# AWS_ACCESS_KEY_ID=              # blank if the EC2 instance has an IAM role
# AWS_SECRET_ACCESS_KEY=
# GRAPH_TENANT_ID=
# GRAPH_CLIENT_ID=
# GRAPH_CLIENT_SECRET=
# GRAPH_MAILBOX=timesheets@yourcompany.com
# GRAPH_FOLDER=Inbox
# GRAPH_OTP_SENDER=               # leave blank — falls back to GRAPH_MAILBOX
# GRAPH_CLIENT_SECRET_EXPIRES_ON=
# CORS_ORIGINS=["https://your-domain.com"]
